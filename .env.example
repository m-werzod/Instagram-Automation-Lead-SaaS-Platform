# ============================================================
# Instagram Automation Platform — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ---- Core -------------------------------------------------
# Public base URL of this app (no trailing slash). Used for OAuth redirects,
# webhook URLs, CSRF origin checks and links in emails.
APP_URL=http://localhost:3000
NODE_ENV=development

# 32+ char random string. Signs nothing itself but pepper for session hashing.
#   openssl rand -hex 32
SESSION_SECRET=

# EXACTLY 64 hex chars (32 bytes) — AES-256-GCM key for Instagram token
# encryption at rest.  Generate:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- Database (PostgreSQL) ---------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ig_automation

# ---- Meta / Instagram ---------------------------------------
# From https://developers.facebook.com/apps → your app.
# App must have the "Instagram" product added (API setup with Instagram login)
# and/or "Facebook Login for Business" + Marketing API for ads features.
META_APP_ID=
META_APP_SECRET=
# Must be registered in the app dashboard, HTTPS in production:
#   {APP_URL}/api/meta/oauth/callback
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
# Any random string; must match the value entered in the App Dashboard webhook config.
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version used for ALL Meta calls.
META_GRAPH_VERSION=v25.0

# ---- AI providers -------------------------------------------
# Default provider: anthropic | openai | google
AI_PROVIDER=anthropic
# Key for the default provider (server-side only, never sent to browser)
AI_API_KEY=
# Optional per-provider keys (used when an agent selects that provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Embeddings for the knowledge base. Provider: openai | google | none
# ("none" = keyword retrieval fallback, no embeddings needed)
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# ---- Email (SMTP) -------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# From: header for outgoing mail
EMAIL_FROM="IG Automation <no-reply@example.com>"
# Where lead notifications are delivered
LEAD_NOTIFICATION_EMAIL=sherzodusmonjonov734@gmail.com

# ---- Bootstrap admin (used by `npm run db:seed`) -------------
ADMIN_EMAIL=admin@example.com
# If empty, the seed prints a generated one-time password to stdout.
ADMIN_PASSWORD=

# ---- Worker --------------------------------------------------
# Poll interval for the DB-backed job queue (ms)
WORKER_POLL_MS=1000
# Identifier shown in job locks / logs (defaults to hostname)
WORKER_ID=

# ---- Optional -------------------------------------------------
# Structured JSON logs also appended to this file (relative to repo root)
LOG_FILE=
# Set to "true" to enable the dev-only webhook simulator endpoint
ENABLE_DEV_SIMULATOR=true
