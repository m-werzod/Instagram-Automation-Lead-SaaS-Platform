// Instagram Automation Platform — relational schema
// Multi-account (tenant) isolation rule: every domain table carries
// instagramAccountId (named accountId) with an FK + index. Cross-account
// queries are forbidden in the data layer (see src/lib/tenancy.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum AdminRole {
  OWNER // full control incl. other admins
  ADMIN // full platform control
  USER // only the Instagram accounts explicitly granted in AccountAccess
}

enum ConnectionMode {
  INSTAGRAM_LOGIN // Business Login for Instagram (graph.instagram.com)
  FACEBOOK_LOGIN // Facebook Login for Business (graph.facebook.com, ads-capable)
}

enum AccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum TokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AIProviderType {
  ANTHROPIC
  OPENAI
  GOOGLE
}

enum MessageDirection {
  IN
  OUT
}

enum MessageSender {
  CUSTOMER
  AI
  ADMIN
  SYSTEM
}

enum ConversationStatus {
  OPEN // AI eligible
  HUMAN // human takeover active
  CLOSED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  WON
  LOST
}

enum QuestionType {
  TEXT
  PHONE
  EMAIL
  NUMBER
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  TIME
  BOOLEAN
}

enum FlowSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED // will be retried
  DEAD // exhausted retries
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum DocStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum CampaignStatus {
  DRAFT // local only, editable
  READY // reviewed, ready to create in Meta
  CREATED // exists in Meta, PAUSED
  ACTIVE // running (spending money)
  PAUSED // paused in Meta after being active
  ARCHIVED
  ERROR
}

enum CtaKind {
  AD_NATIVE // real Meta ad CTA button (Marketing API, mode B only)
  CREATIVE_OVERLAY // CTA rendered into the creative before publishing (visual, not a button)
  EXTERNAL_LINK // hosted landing page on this platform / external URL
  MESSAGING // keyword/comment → DM lead flow
}

enum AutomationTriggerType {
  MESSAGE_RECEIVED
  COMMENT_RECEIVED
  LEAD_SUBMITTED
  LEAD_STATUS_CHANGED
  CONVERSATION_HANDOFF
}

// ---------- auth ----------

model Admin {
  id           String    @id @default(cuid())
  /// Username used to sign in (case-insensitive: always stored lowercased).
  login        String    @unique
  /// Optional contact address — NOT used for authentication.
  email        String?   @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  connectInvites  ConnectInvite[]
  accountAccess   AccountAccess[]
  paymentCustomer PaymentCustomer?
  assignedLeads   Lead[]
}

model Session {
  id         String    @id @default(cuid())
  adminId    String
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // sha256(token + SESSION_SECRET); raw token only in cookie
  createdAt  DateTime  @default(now())
  expiresAt  DateTime // absolute lifetime
  lastSeenAt DateTime  @default(now()) // idle timeout basis
  ip         String?
  userAgent  String?
  revokedAt  DateTime?

  @@index([adminId])
  @@index([expiresAt])
}

/// Which Instagram accounts a USER-role admin may see and operate. OWNER and
/// ADMIN are unrestricted and never need rows here. Enforced server-side in
/// src/lib/auth/access.ts on every account-scoped route.
model AccountAccess {
  id          String           @id @default(cuid())
  adminId     String
  admin       Admin            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grantedById String?
  createdAt   DateTime         @default(now())

  @@unique([adminId, accountId])
  @@index([accountId])
}

// Single-row global switches (id always 1)
model GlobalSettings {
  id                        Int      @id @default(1)
  masterAutomationEnabled   Boolean  @default(true)
  autoCampaignLaunchEnabled Boolean  @default(false) // spec §16 — default OFF
  leadAutomationWhenOff     Boolean  @default(true) // lead capture may continue while master is OFF
  // Telegram lead notifications — the primary CRM receiver.
  telegramBotToken          String? // AES-256-GCM blob (src/lib/crypto.ts) — never stored in plain text
  telegramChatId            String? // auto-detected from getUpdates on first use if empty
  telegramEnabled           Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

// ---------- Instagram accounts & tokens ----------

model InstagramAccount {
  id                String         @id @default(cuid())
  igUserId          String         @unique // Instagram professional account ID
  username          String
  name              String?
  accountType       String? // BUSINESS | MEDIA_CREATOR
  profilePictureUrl String?
  followersCount    Int?
  mediaCount        Int?
  connectionMode    ConnectionMode
  fbPageId          String? // mode B
  fbPageName        String? // mode B
  adAccountId       String? // mode B, "act_..." — required for campaigns
  status            AccountStatus  @default(CONNECTED)
  webhookSubscribed Boolean        @default(false)
  lastSyncAt        DateTime?
  isDemo            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tokens           InstagramToken[]
  permissions      InstagramPermission[]
  agents           AIAgent[]
  content          ContentItem[]
  conversations    Conversation[]
  documents        KnowledgeDocument[]
  chunks           KnowledgeChunk[]
  leadFlows        LeadFlow[]
  flowSessions     LeadFlowSession[]
  leads            Lead[]
  ctaConfigs       CtaConfig[]
  campaigns        Campaign[]
  automations      Automation[]
  aiUsage          AIUsage[]
  connectInvites   ConnectInvite[]
  accessGrants     AccountAccess[]
  mediaAssets      MediaAsset[]
  publishJobs      PublishJob[]
  commentResources CommentResource[]
  videoProjects    VideoProject[]
  videoAssets      VideoAsset[]
  videoJobs        VideoJob[]
}

model InstagramToken {
  id            String           @id @default(cuid())
  accountId     String
  account       InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind          String // "user" | "page"
  encrypted     String // AES-256-GCM {iv,tag,data} base64 blob — see src/lib/crypto.ts
  status        TokenStatus      @default(ACTIVE)
  scopes        String[]
  issuedAt      DateTime         @default(now())
  expiresAt     DateTime?
  lastRefreshAt DateTime?
  lastCheckedAt DateTime?

  @@index([accountId])
  @@index([status, expiresAt])
}

model InstagramPermission {
  id         String           @id @default(cuid())
  accountId  String
  account    InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean          @default(true)
  checkedAt  DateTime         @default(now())

  @@unique([accountId, permission])
}

// ---------- content ----------

/// A single-use link that lets the OWNER of an Instagram account authorize it
/// without having an account on this platform.
///
/// Instagram has no API to "request access" to a handle — only the person
/// holding the account can approve, on instagram.com, in their own browser. So
/// onboarding someone else's account means sending them a link. This row is
/// what makes that link safe: it is single-use, expiring, revocable, and grants
/// exactly one capability (attach one Instagram account) rather than a session.
model ConnectInvite {
  id        String  @id @default(cuid())
  /// sha256(token + SESSION_SECRET). The raw token exists only inside the link
  /// that was handed out, so a database leak cannot be replayed.
  tokenHash String  @unique
  /// Free text the admin entered to tell invites apart (usually the expected
  /// @handle). Never used to authenticate — Instagram decides who signs in.
  label     String?

  createdById String?
  createdBy   Admin?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  /// The account this invite produced, once it has been used.
  accountId String?
  account   InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([createdById])
}

model ContentItem {
  id               String           @id @default(cuid())
  accountId        String
  account          InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mediaId          String // Instagram media ID
  mediaType        String // IMAGE | VIDEO | CAROUSEL_ALBUM
  mediaProductType String? // FEED | REELS | STORY
  caption          String?          @db.Text
  mediaUrl         String?
  thumbnailUrl     String?
  permalink        String?
  timestamp        DateTime?
  likeCount        Int?
  commentsCount    Int?
  insights         Json? // last fetched media insights (views era — never "impressions")
  isDemo           Boolean          @default(false)
  syncedAt         DateTime         @default(now())

  analysis    ContentAnalysis?
  ctaConfigs  CtaConfig[]
  campaigns   Campaign[]
  leads       Lead[]
  automations Automation[]

  @@unique([accountId, mediaId])
  @@index([accountId, timestamp])
}

model ContentAnalysis {
  id                   String      @id @default(cuid())
  contentId            String      @unique
  content              ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  provider             String
  model                String
  topic                String?
  audience             String?
  salesIntent          String?
  leadPotential        String? // LOW | MEDIUM | HIGH
  recommendedCta       String?
  recommendedObjective String?
  recommendedCopy      String?     @db.Text
  captionQuality       String?
  reasoning            String?     @db.Text
  raw                  Json?
  createdAt            DateTime    @default(now())
}

// ---------- AI agents ----------

model AIAgent {
  id          String           @id @default(cuid())
  accountId   String
  account     InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean          @default(false)
  provider    AIProviderType   @default(ANTHROPIC)
  model       String
  temperature Float            @default(0.7)
  maxTokens   Int              @default(1024)

  systemPrompt      String  @db.Text
  tone              String?
  language          String?
  businessContext   String? @db.Text // ONLY source of prices/addresses/policies for the AI
  salesStrategy     String? @db.Text
  conversationRules String? @db.Text
  escalationRules   String? @db.Text

  // feature toggles — each is enforced in the worker pipeline, not decorative
  autoReply                Boolean @default(true)
  leadQualification        Boolean @default(true)
  knowledgeEnabled         Boolean @default(true)
  humanHandoffEnabled      Boolean @default(true)
  autoFollowUp             Boolean @default(false)
  commentReplyEnabled      Boolean @default(false)
  maxRepliesPerUserPerHour Int     @default(20)

  // tool permission system (spec §34/§35): ids from src/lib/agent/tools.ts
  allowedTools String[]

  // availability + safety (src/lib/agent/guardrails.ts) — each enforced in the runtime
  workingHours      Json? // {timezone, days:[0-6], start:"HH:MM", end:"HH:MM"}; null = always on
  outsideHoursReply String? @db.Text // sent once per 12h when a message arrives outside working hours
  fallbackReply     String? @db.Text // sent when the model fails or the reply is blocked by a guardrail
  allowedTopics     String? @db.Text // comma/newline separated; steers the model, shown in the prompt
  prohibitedTopics  String? @db.Text // comma/newline separated; replies mentioning them are blocked
  responseLength    String  @default("SHORT") // SHORT | MEDIUM | LONG → max tokens + prompt hint
  ctaText           String? @db.Text // the call-to-action the assistant works towards
  faq               String? @db.Text // quick Q&A pairs, injected into the prompt (no upload needed)

  defaultLeadFlowId String?
  isDemo            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversations Conversation[]
  documents     KnowledgeDocument[]
  aiUsage       AIUsage[]

  @@index([accountId])
}

// ---------- conversations ----------

model Conversation {
  id                 String             @id @default(cuid())
  accountId          String
  account            InstagramAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igsid              String // Instagram-scoped user id of the customer
  username           String?
  status             ConversationStatus @default(OPEN)
  aiEnabled          Boolean            @default(true)
  takenOverByAdminId String?
  agentId            String?
  agent              AIAgent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  leadId             String?
  lastUserMessageAt  DateTime? // 24h messaging-window anchor
  lastMessageAt      DateTime?
  lastMessagePreview String?
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  messages     Message[]
  flowSessions LeadFlowSession[]

  @@unique([accountId, igsid])
  @@index([accountId, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mid               String?          @unique // Meta message id — webhook dedupe anchor
  direction         MessageDirection
  sender            MessageSender
  text              String?          @db.Text
  attachments       Json?
  quickReplyPayload String?
  sentByAdminId     String?
  aiLatencyMs       Int?
  raw               Json?
  createdAt         DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// ---------- knowledge base ----------

model KnowledgeDocument {
  id                String           @id @default(cuid())
  accountId         String
  account           InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agentId           String? // null = shared across the account's agents
  agent             AIAgent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  title             String
  filename          String?
  mimeType          String?
  sizeBytes         Int?
  status            DocStatus        @default(PENDING)
  error             String?
  chunkCount        Int              @default(0)
  embeddingProvider String? // "none" → keyword retrieval
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  chunks KnowledgeChunk[]

  @@index([accountId])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accountId  String
  account    InstagramAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  idx        Int
  text       String            @db.Text
  embedding  Bytes? // Float32Array buffer; null in keyword mode

  @@index([documentId])
  @@index([accountId])
}

// ---------- lead flows ----------

model LeadFlow {
  id                String           @id @default(cuid())
  accountId         String
  account           InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  enabled           Boolean          @default(true)
  triggerKeywords   String[] // DM keywords that start this flow
  completionMessage String?          @db.Text
  isDemo            Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  questions LeadFlowQuestion[]
  sessions  LeadFlowSession[]
  leads     Lead[]

  @@index([accountId])
}

model LeadFlowQuestion {
  id              String       @id @default(cuid())
  flowId          String
  flow            LeadFlow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  order           Int
  title           String // "Full Name"
  prompt          String       @db.Text // exact text sent to the user
  type            QuestionType
  required        Boolean      @default(true)
  options         String[] // SINGLE_SELECT / MULTI_SELECT
  mapTo           String? // "name" | "phone" | "email" → lead columns
  validationRegex String?

  answers LeadAnswer[]

  @@unique([flowId, order])
}

model LeadFlowSession {
  id                String            @id @default(cuid())
  flowId            String
  flow              LeadFlow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  accountId         String
  account           InstagramAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status            FlowSessionStatus @default(ACTIVE)
  currentQuestionId String?
  askedAt           DateTime? // when current question was sent
  leadId            String?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?

  answers LeadAnswer[]

  @@index([conversationId, status])
  @@index([accountId, status])
}

model LeadAnswer {
  id         String           @id @default(cuid())
  sessionId  String
  session    LeadFlowSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   LeadFlowQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String           @db.Text
  createdAt  DateTime         @default(now())

  @@unique([sessionId, questionId])
}

// ---------- CRM ----------

model Lead {
  id                String           @id @default(cuid())
  accountId         String
  account           InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  igsid             String? // instagram user (if from DM)
  conversationId    String?
  name              String?
  phone             String?
  email             String?
  answers           Json? // [{question, answer}] snapshot at submission
  source            String           @default("instagram_dm") // instagram_dm | instagram_comment | landing_page | lead_ad | manual
  campaignId        String?
  campaign          Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentId         String?
  content           ContentItem?     @relation(fields: [contentId], references: [id], onDelete: SetNull)
  flowId            String?
  flow              LeadFlow?        @relation(fields: [flowId], references: [id], onDelete: SetNull)
  ctaConfigId       String? // which Lead Button captured this lead
  ctaConfig         CtaConfig?       @relation(fields: [ctaConfigId], references: [id], onDelete: SetNull)
  status            LeadStatus       @default(NEW)
  notes             String?          @db.Text
  assignedAdminId   String? // which staff/user member is working this lead
  assignedAdmin     Admin?           @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  /// Set by the AI's qualify_lead tool — {score: LOW|MEDIUM|HIGH, summary, signals}.
  /// Never invented outside a real model call; null until the AI (or nobody) has assessed it.
  aiQualification   Json?
  lastInteractionAt DateTime? // most recent message/answer/status change touching this lead
  /// Free labels an admin puts on a lead. Plain array (not a join table): tags
  /// here are per-account strings with no attributes of their own, and every
  /// query filters within one account.
  tags              String[]
  /// Next action date. The CRM surfaces overdue follow-ups; nothing sends
  /// anything automatically off this field.
  followUpAt        DateTime?
  /// Expected deal value in minor units of `valueCurrency`, entered by staff.
  valueCents        Int?
  valueCurrency     String?
  /// Why a lead was marked WON or LOST — free text chosen by staff.
  outcomeReason     String?
  isDemo            Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  events LeadEvent[]

  @@index([accountId, status])
  @@index([accountId, createdAt])
  @@index([ctaConfigId])
  @@index([assignedAdminId])
  @@index([accountId, followUpAt])
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // CREATED | STATUS_CHANGED | NOTE_ADDED | EMAIL_SENT | EMAIL_FAILED
  data      Json?
  adminId   String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// ---------- CTA ----------

model CtaConfig {
  id               String           @id @default(cuid())
  accountId        String
  account          InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contentId        String?
  content          ContentItem?     @relation(fields: [contentId], references: [id], onDelete: Cascade)
  name             String
  kind             CtaKind
  enabled          Boolean          @default(true)
  ctaType          String? // AD_NATIVE: Meta enum value (SIGN_UP, LEARN_MORE, ...)
  url              String? // EXTERNAL_LINK destination (or hosted page)
  landingSlug      String?          @unique // hosted landing page /f/{slug}
  leadFlowId       String?
  overlaySpec      Json? // CREATIVE_OVERLAY: {text, position, bgColor, textColor} — visual only
  messagingKeyword String? // MESSAGING: comment/DM keyword trigger
  buttonSpec       Json? // Lead Button appearance {label, helper, bg, fg, border, shape, size, style} — rendered on /f/{slug} and in the builder preview
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  leads     Lead[]
  campaigns Campaign[]

  @@index([accountId])
}

// ---------- campaigns ----------

model Campaign {
  id                  String           @id @default(cuid())
  accountId           String
  account             InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                String
  objective           String // OUTCOME_LEADS | OUTCOME_TRAFFIC | OUTCOME_ENGAGEMENT | OUTCOME_SALES | OUTCOME_AWARENESS
  status              CampaignStatus   @default(DRAFT)
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  currency            String           @default("USD")
  startTime           DateTime?
  endTime             DateTime?
  targeting           Json? // {countries, ageMin, ageMax, genders, instagramPositions}
  ctaType             String?
  destinationType     String? // WEBSITE | INSTAGRAM_DIRECT | LEAD_FORM
  destinationUrl      String?
  leadFlowId          String?
  contentId           String? // boost existing media (source_instagram_media_id)
  content             ContentItem?     @relation(fields: [contentId], references: [id], onDelete: SetNull)
  /// Which Lead Button (CtaConfig, kind EXTERNAL_LINK) this ad uses — set once at
  /// creation from whichever the admin picked, not re-derived on sync (Meta ad
  /// creatives are immutable after creation anyway). Purely additive: nothing
  /// requires this to be set, ctaType/destinationUrl above still drive the ad.
  ctaConfigId         String?
  ctaConfig           CtaConfig?       @relation(fields: [ctaConfigId], references: [id], onDelete: SetNull)
  creativeSpec        Json?
  createdByAi         Boolean          @default(false)
  createdByAdminId    String?
  metaCampaignId      String?
  metaAdSetId         String?
  metaCreativeId      String?
  metaAdId            String?
  metaFormId          String? // lead ads instant form
  lastError           String?
  /// Meta's own ad review verdict, as reported by the Graph API on sync:
  /// effective_status (e.g. PENDING_REVIEW, DISAPPROVED, ACTIVE) plus any
  /// issues_info Meta returns. Never inferred locally — null until Meta says.
  reviewStatus        String?
  reviewIssues        Json?
  reviewSyncedAt      DateTime?
  estimate            Json? // Meta reachestimate snapshot {available, usersLowerBound, usersUpperBound, fetchedAt} — never computed locally
  insightsSnapshot    Json? // last Meta insights {spend, impressions, reach, clicks, results, ...}
  insightsSyncedAt    DateTime?
  stoppedAt           DateTime?
  platformFeeCents    Int? // platform service fee charged for this campaign (Meta spend is billed by Meta)
  publishedAt         DateTime?
  publishedByAdminId  String?
  isDemo              Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  leads            Lead[]
  payments         Payment[]
  billingSchedules BillingSchedule[]

  @@index([accountId, status])
  @@index([ctaConfigId])
}

// ---------- automations ----------

model Automation {
  id          String                @id @default(cuid())
  accountId   String
  account     InstagramAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  enabled     Boolean               @default(false)
  trigger     AutomationTriggerType
  conditions  Json // [{field, op, value}] — AND-combined
  actions     Json // [{type, params}] — executed in order
  /// Scopes a COMMENT_RECEIVED rule to one post/reel; null = every post on the account.
  contentId   String?
  content     ContentItem?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  /// Minimum gap before this rule fires OUTBOUND actions again for the SAME
  /// Instagram user (igsid) — prevents re-commenting the same keyword from
  /// spamming a repeat DM/reply. null = no cooldown (fires every match, the
  /// pre-existing behavior — backward compatible with every rule already saved).
  cooldownSec Int?
  runCount    Int                   @default(0)
  lastRunAt   DateTime?
  isDemo      Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  runs AutomationRun[]

  @@index([accountId, trigger, enabled])
  @@index([contentId])
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String // SUCCESS | FAILED | SKIPPED
  /// The Instagram user (igsid) this run fired for, when known — denormalized
  /// out of triggerData purely so the cooldown check (runAutomations) can look
  /// up "did this rule already fire for this person recently" with an index
  /// instead of scanning JSON.
  actorIgsid   String?
  triggerData  Json?
  result       Json?
  error        String?
  durationMs   Int?
  createdAt    DateTime   @default(now())

  @@index([automationId, createdAt])
  @@index([automationId, actorIgsid, createdAt])
}

// ---------- infrastructure ----------

model WebhookEvent {
  id             String    @id @default(cuid())
  object         String // "instagram" | "page"
  dedupeKey      String    @unique
  payload        Json
  signatureValid Boolean   @default(true)
  status         String    @default("RECEIVED") // RECEIVED | QUEUED | PROCESSED | FAILED | IGNORED
  error          String?
  processedAt    DateTime?
  receivedAt     DateTime  @default(now())

  @@index([status, receivedAt])
}

// DB-backed job queue (FOR UPDATE SKIP LOCKED claiming — see src/lib/queue)
model Job {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  /// Execution lane. "default" jobs are short and may run inside the 60s
  /// serverless cron drain; "video" jobs are minutes-long FFmpeg work that only
  /// a resident worker with ffmpeg may claim. A drain never claims a lane it
  /// cannot finish, so a render can never be killed mid-flight by a platform timeout.
  lane           String    @default("default")
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  /// Lock lease. Renewed by the running worker (heartbeat); recovery only
  /// reclaims a job once this has passed, so a legitimately long job is never
  /// stolen and run twice.
  leaseExpiresAt DateTime?
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt, priority])
  @@index([status, lane, runAt, priority])
  @@index([status, leaseExpiresAt])
}

/// Liveness of every process that drains the queue, so the platform can tell
/// "queue idle" from "nothing is draining" — and can say honestly whether a
/// video-capable worker (ffmpeg present) is online before accepting renders.
model WorkerHeartbeat {
  id         String   @id // workerId
  lanes      String[]
  ffmpeg     Boolean  @default(false)
  kind       String   @default("worker") // worker | cron | inline
  lastSeenAt DateTime @default(now())
  jobsDone   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([lastSeenAt])
}

model AIUsage {
  id           String            @id @default(cuid())
  accountId    String?
  account      InstagramAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  agentId      String?
  agent        AIAgent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  purpose      String // reply | content_analysis | embedding | campaign_draft
  inputTokens  Int               @default(0)
  outputTokens Int               @default(0)
  costUsd      Float?
  latencyMs    Int?
  success      Boolean           @default(true)
  error        String?
  createdAt    DateTime          @default(now())

  @@index([accountId, createdAt])
}

model EmailEvent {
  id        String      @id @default(cuid())
  to        String
  subject   String
  template  String // lead_notification | admin_alert | test
  payload   Json?
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  leadId    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String?
  admin        Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action       String // CONNECTED_INSTAGRAM, CHANGED_AGENT_PROMPT, PUBLISHED_CAMPAIGN, ...
  resourceType String?
  resourceId   String?
  before       Json?
  after        Json?
  ip           String?
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action, createdAt])
}

// ---------- publishing (Instagram content publishing API) ----------

enum PublishStatus {
  DRAFT
  SCHEDULED // waiting for scheduledAt (platform-side scheduling — Instagram has none)
  PROCESSING // containers created, Meta is processing the media
  PUBLISHED
  FAILED // admin can retry
  CANCELLED
}

/// A file the platform hosts so Meta can download it while publishing. Meta
/// only accepts media on a public URL; images are stored inline (≤ 4 MB — the
/// serverless request limit) and served from /m/{id}.{ext}. Larger media is
/// referenced by an external URL instead.
model MediaAsset {
  id           String           @id @default(cuid())
  accountId    String
  account      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String // IMAGE | VIDEO
  mimeType     String
  sizeBytes    Int
  data         Bytes?
  externalUrl  String?
  uploadedById String?
  createdAt    DateTime         @default(now())

  @@index([accountId, createdAt])
}

/// A file an admin uploads to hand to people who comment on a post (a price
/// list, a catalogue, a lookbook) — served publicly at /r/{id} the same way
/// MediaAsset is, but deliberately a separate model: this table is never fed
/// into Instagram's publish pipeline (so it accepts PDFs/docs MediaAsset's
/// upload route rightly rejects) and keeps a human-facing `name`, which
/// publishing has no use for.
model CommentResource {
  id           String           @id @default(cuid())
  accountId    String
  account      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String // admin-facing label, e.g. "Price list PDF"
  kind         String // IMAGE | VIDEO | FILE — decides native attachment vs link-in-text at send time
  mimeType     String
  sizeBytes    Int
  data         Bytes?
  externalUrl  String?
  uploadedById String?
  createdAt    DateTime         @default(now())

  @@index([accountId, createdAt])
}

model PublishJob {
  id                String           @id @default(cuid())
  accountId         String
  account           InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mediaType         String // IMAGE | REELS | STORIES | CAROUSEL
  caption           String?          @db.Text
  items             Json // [{url, kind}] — 1 item, or 2–10 for CAROUSEL
  shareToFeed       Boolean?
  coverUrl          String?
  status            PublishStatus    @default(SCHEDULED)
  scheduledAt       DateTime
  startedAt         DateTime?
  publishedAt       DateTime?
  containerId       String?
  childContainerIds String[]
  publishedMediaId  String?
  permalink         String?
  attempts          Int              @default(0)
  lastError         String?          @db.Text
  createdByAdminId  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([accountId, status])
  @@index([status, scheduledAt])
}

// ---------- billing (platform service payments — NOT Meta ad spend) ----------
//
// Card data never touches this database: the provider (Stripe) tokenises the
// card in its own hosted Checkout, and only opaque provider ids plus display
// metadata (brand, last4, expiry) are stored here.

enum PaymentStatus {
  PENDING // created, waiting for the customer (or the scheduler) to pay
  PROCESSING // provider is confirming
  REQUIRES_ACTION // 3-D Secure etc. — customer must finish in Checkout
  SUCCEEDED
  FAILED // retry allowed
  CANCELED
  REFUNDED
}

enum BillingScheduleStatus {
  ACTIVE
  PAUSED
  CANCELED
}

/// One provider customer per platform user. `autoPay` is the "Automatic
/// payments" switch: ON = due payments are charged to the default saved card;
/// OFF = they wait as PENDING and the user is told to pay manually.
model PaymentCustomer {
  id                     String   @id @default(cuid())
  adminId                String   @unique
  admin                  Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  provider               String   @default("stripe")
  providerCustomerId     String   @unique
  email                  String?
  currency               String   @default("USD")
  autoPay                Boolean  @default(false)
  defaultPaymentMethodId String? // PaymentMethod.id
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  paymentMethods PaymentMethod[]
  payments       Payment[]
  schedules      BillingSchedule[]
}

model PaymentMethod {
  id               String          @id @default(cuid())
  customerId       String
  customer         PaymentCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  providerMethodId String          @unique
  brand            String?
  last4            String?
  expMonth         Int?
  expYear          Int?
  createdAt        DateTime        @default(now())
  removedAt        DateTime?

  @@index([customerId])
}

model Payment {
  id                        String           @id @default(cuid())
  customerId                String
  customer                  PaymentCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind                      String // CAMPAIGN_FEE | PLAN | MANUAL
  description               String
  amountCents               Int
  currency                  String
  status                    PaymentStatus    @default(PENDING)
  /// exactly-once guard for creation AND for the provider charge
  idempotencyKey            String           @unique
  providerPaymentIntentId   String?          @unique
  providerCheckoutSessionId String?          @unique
  providerChargeId          String?
  receiptUrl                String?
  failureCode               String?
  failureMessage            String?
  attempts                  Int              @default(0)
  campaignId                String?
  campaign                  Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  scheduleId                String?
  schedule                  BillingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  dueAt                     DateTime?
  paidAt                    DateTime?
  failedAt                  DateTime?
  refundedAt                DateTime?
  canceledAt                DateTime?
  nextRetryAt               DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  invoice Invoice?

  @@index([customerId, createdAt])
  @@index([status, nextRetryAt])
  @@index([campaignId])
}

model Invoice {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  number      String   @unique // INV-2026-00001
  amountCents Int
  currency    String
  lines       Json // [{description, amountCents}]
  receiptUrl  String?
  issuedAt    DateTime @default(now())
}

/// A recurring platform charge (plan or per-campaign management fee).
model BillingSchedule {
  id            String                @id @default(cuid())
  customerId    String
  customer      PaymentCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name          String
  amountCents   Int
  currency      String
  intervalDays  Int                   @default(30)
  nextBillingAt DateTime
  lastBilledAt  DateTime?
  status        BillingScheduleStatus @default(ACTIVE)
  campaignId    String?
  campaign      Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  canceledAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  payments Payment[]

  @@index([status, nextBillingAt])
  @@index([customerId])
}

/// Provider webhook deliveries — unique on the provider's event id so a
/// redelivery is acknowledged but never processed twice.
model BillingEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  type            String
  payload         Json
  status          String    @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | FAILED
  error           String?
  processedAt     DateTime?
  receivedAt      DateTime  @default(now())

  @@index([status, receivedAt])
}

/// Single row (id = 1). What this platform charges; editable by the OWNER.
model PricingConfig {
  id                 Int      @id @default(1)
  currency           String   @default("USD")
  campaignFeeCents   Int      @default(0) // flat fee per campaign created through the platform
  campaignFeePercent Float    @default(0) // % of the campaign's first budget period
  planName           String?
  planAmountCents    Int      @default(0) // recurring plan, 0 = no plan
  planIntervalDays   Int      @default(30)
  taxPercent         Float    @default(0)
  updatedAt          DateTime @updatedAt
}

// ============================================================
// AI Video Editor
// ============================================================
//
// Media bytes NEVER live in this database. Postgres holds only metadata and a
// storage key; the bytes sit behind a storage driver (local disk for a resident
// worker, Vercel Blob for serverless), because Postgres bytea plus the 4.5 MB
// serverless body limit cannot carry video. See src/lib/storage/.
//
// All heavy work runs as a Job in the "video" lane, which only a resident
// worker with FFmpeg claims — the 60s serverless drain is structurally unable
// to pick up a render it would be killed halfway through.

enum VideoProjectStatus {
  DRAFT
  READY // has at least one completed export
  ARCHIVED
}

enum VideoAssetRole {
  SOURCE // the video being edited
  AUDIO // uploaded music / voice-over / sound effect
  SAMPLE // reference video whose style is being analysed
  EXPORT // finished render
  PREVIEW // low-resolution proxy for iteration
  THUMBNAIL // extracted frame (also usable as a Reel cover)
}

enum VideoAssetStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum VideoJobKind {
  PROBE // ffprobe metadata
  PREVIEW // fast low-res render
  EXPORT // full-quality render
  TRANSCRIBE // speech-to-text for subtitles
  SAMPLE_ANALYZE // style analysis of a reference video
  THUMBNAIL // extract a cover frame
  WAVEFORM // audio peaks for the timeline UI
}

enum VideoJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum SubtitleSource {
  AUTO // speech-to-text
  MANUAL // typed or edited by a human
  IMPORTED // uploaded SRT/VTT
}

/// One editing project: a source video plus the edit parameters applied to it.
model VideoProject {
  id            String             @id @default(cuid())
  accountId     String
  account       InstagramAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title         String
  status        VideoProjectStatus @default(DRAFT)
  sourceAssetId String?            @unique
  sourceAsset   VideoAsset?        @relation("ProjectSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  /// Validated EditParams (see src/lib/video/params.ts). The single source of
  /// truth for what a render will do; the chat assistant only ever proposes a
  /// patch to this, it never executes anything itself.
  params        Json?
  /// Append-only undo stack of previous `params` values, newest last.
  history       Json?
  lastExportId  String?
  createdById   String?
  isDemo        Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  assets   VideoAsset[]       @relation("ProjectAssets")
  jobs     VideoJob[]
  subtitle SubtitleTrack[]
  samples  SampleAnalysis[]
  messages VideoChatMessage[]

  @@index([accountId, updatedAt])
  @@index([accountId, status])
}

/// A media file held by the storage driver. `storageKey` + `driver` locate the
/// bytes; this row never contains them.
model VideoAsset {
  id           String           @id @default(cuid())
  accountId    String
  account      InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId    String?
  project      VideoProject?    @relation("ProjectAssets", fields: [projectId], references: [id], onDelete: Cascade)
  role         VideoAssetRole
  status       VideoAssetStatus @default(UPLOADING)
  filename     String
  mimeType     String
  sizeBytes    Int
  driver       String // local | vercel-blob
  storageKey   String
  /// Public URL when the driver has one (Vercel Blob). Local storage serves
  /// through a signed, expiring route instead.
  publicUrl    String?
  durationSec  Float?
  width        Int?
  height       Int?
  fps          Float?
  hasAudio     Boolean          @default(false)
  /// Raw ffprobe output, kept for diagnosis and for honest capability checks.
  probe        Json?
  error        String?          @db.Text
  uploadedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sourceOf VideoProject?    @relation("ProjectSource")
  jobs     VideoJob[]       @relation("JobOutput")
  samples  SampleAnalysis[]

  @@index([accountId, createdAt])
  @@index([projectId, role])
  @@index([status])
}

/// A unit of FFmpeg/AI work. The user-visible record; execution rides the
/// existing Job queue in the "video" lane (queueJobId links the two).
model VideoJob {
  id            String           @id @default(cuid())
  accountId     String
  account       InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId     String
  project       VideoProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind          VideoJobKind
  status        VideoJobStatus   @default(QUEUED)
  /// Validated parameters for this specific run (a frozen copy, so editing the
  /// project mid-render cannot change what is being rendered).
  params        Json
  progressPct   Int              @default(0)
  outputAssetId String?
  outputAsset   VideoAsset?      @relation("JobOutput", fields: [outputAssetId], references: [id], onDelete: SetNull)
  /// Tail of FFmpeg stderr — what actually explains a failure.
  logTail       String?          @db.Text
  error         String?          @db.Text
  queueJobId    String?
  cancelledAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, createdAt])
  @@index([accountId, status])
  @@index([status, createdAt])
}

/// Subtitles for a project: timed cues plus their visual style.
model SubtitleTrack {
  id        String         @id @default(cuid())
  projectId String
  project   VideoProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language  String // uz | ru | en | other BCP-47
  source    SubtitleSource @default(AUTO)
  /// [{start, end, text, words?: [{start, end, text}]}] — word timings only
  /// when the transcription provider actually returned them; word-level
  /// highlight presets stay unavailable otherwise rather than faking timings.
  cues      Json
  /// Validated SubtitleStyle (font, size, weight, colours, background opacity,
  /// position, outline, shadow, alignment, preset name).
  style     Json
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([projectId])
}

/// Style analysis of a reference ("sample") video, and the editing plan derived
/// from it. Every plan item carries a feasibility verdict, so the UI can say
/// plainly what will be reproduced, what is approximated, and what cannot be
/// reconstructed.
model SampleAnalysis {
  id            String         @id @default(cuid())
  projectId     String
  project       VideoProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sampleAssetId String
  sampleAsset   VideoAsset     @relation(fields: [sampleAssetId], references: [id], onDelete: Cascade)
  status        VideoJobStatus @default(QUEUED)
  /// Measured facts: duration, aspect, scene-cut timestamps, cut cadence,
  /// loudness, detected letterboxing, speech/music windows.
  measured      Json?
  /// Model-written observations (subtitle presence/position, pacing, colour
  /// treatment). Clearly separated from `measured` because it is an opinion.
  observed      Json?
  /// [{op, params, feasibility: reproducible|approximate|unsupported, note}]
  plan          Json?
  error         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId, createdAt])
}

/// A turn in the editor's chat assistant. Assistant turns may carry a proposed
/// EditParams patch, which is applied only on explicit user confirmation.
model VideoChatMessage {
  id        String       @id @default(cuid())
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  text      String       @db.Text
  /// Proposed operations: {patch, summary, unsupported[]}. Null for plain talk.
  proposal  Json?
  /// PROPOSED | APPLIED | REJECTED | NONE
  state     String       @default("NONE")
  language  String? // detected language of the user's turn (uz | ru | en)
  createdAt DateTime     @default(now())

  @@index([projectId, createdAt])
}
