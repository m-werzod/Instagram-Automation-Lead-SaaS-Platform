# ============================================================
# Instagram Automation Platform — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# ---- Core -------------------------------------------------
# Public base URL of this app (no trailing slash). Used for OAuth redirects,
# webhook URLs, CSRF origin checks and links in emails.
APP_URL=http://localhost:3000
NODE_ENV=development

# Extra addresses allowed to submit forms (comma-separated), for when the app is
# reached at something other than APP_URL — e.g. a second domain or a LAN IP.
# In development, localhost / 127.0.0.1 / private LAN addresses are always allowed.
#   TRUSTED_ORIGINS=https://ops.example.com,http://192.168.1.50:3000
TRUSTED_ORIGINS=

# 32+ char random string. Signs nothing itself but pepper for session hashing.
#   openssl rand -hex 32
SESSION_SECRET=

# EXACTLY 64 hex chars (32 bytes) — AES-256-GCM key for Instagram token
# encryption at rest.  Generate:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- Database (PostgreSQL) ---------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ig_automation

# ---- Meta / Instagram ---------------------------------------
# From https://developers.facebook.com/apps → your app.
# App must have the "Instagram" product added (API setup with Instagram login)
# and/or "Facebook Login for Business" + Marketing API for ads features.
META_APP_ID=
META_APP_SECRET=

# Instagram Login uses SEPARATE credentials from the Facebook app above.
# App Dashboard -> Instagram -> API setup with Instagram login -> Business login settings.
# Using the Facebook app id here makes Instagram reject it: "Invalid platform app".
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
# Must be registered in the app dashboard, HTTPS in production:
#   {APP_URL}/api/meta/oauth/callback
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
# Any random string; must match the value entered in the App Dashboard webhook config.
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version used for ALL Meta calls.
META_GRAPH_VERSION=v25.0

# ---- AI providers -------------------------------------------
# Default provider: anthropic | openai | google
AI_PROVIDER=anthropic
# Key for the default provider (server-side only, never sent to browser)
AI_API_KEY=
# OpenAI-compatible base URL (AI_PROVIDER=openai). Default https://api.openai.com/v1.
# Any gateway speaking the same protocol works, e.g. https://api.airforce/v1
AI_API_BASE_URL=
# Model for new agents and background analysis (must exist on the provider above)
AI_MODEL=
# Per-call timeout in ms (min 5000, default 60000)
AI_TIMEOUT_MS=
# Optional per-provider keys (used when an agent selects that provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Embeddings for the knowledge base. Provider: openai | google | none
# ("none" = keyword retrieval fallback, no embeddings needed)
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=

# ---- Email (SMTP) -------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# From: header for outgoing mail
EMAIL_FROM="IG Automation <no-reply@example.com>"
# Where lead notifications are delivered
LEAD_NOTIFICATION_EMAIL=sherzodusmonjonov734@gmail.com

# ---- Bootstrap admin (used by `npm run db:seed`) -------------
# Sign-in uses this LOGIN (a username), not an email address.
ADMIN_LOGIN=Admin
# If empty, the seed prints a generated one-time password to stdout.
# If set, re-running the seed resets the bootstrap admin's password to it.
ADMIN_PASSWORD=
# Optional contact address for the admin record (not used to sign in).
ADMIN_EMAIL=

# ---- Worker --------------------------------------------------
# Poll interval for the DB-backed job queue (ms)
WORKER_POLL_MS=1000
# Identifier shown in job locks / logs (defaults to hostname)
WORKER_ID=

# Serverless hosting (Vercel etc.) cannot run the long-lived worker process.
# Set a random secret here and have a scheduler call
#   GET /api/cron/worker   with   Authorization: Bearer <this value>
# The endpoint stays closed while this is unset.
#   openssl rand -hex 24
CRON_SECRET=

# ---- Optional -------------------------------------------------
# Structured JSON logs also appended to this file (relative to repo root)
LOG_FILE=
# Set to "true" to enable the dev-only webhook simulator endpoint
ENABLE_DEV_SIMULATOR=true

# ---- Telegram lead notifications (optional env fallback) ----
# The normal way is Settings -> Telegram in the app (token stored encrypted in DB).
# These env vars are a fallback for installations that prefer env config.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=123456789
